# PostgreSQL connection string (required)
# Example for a local database: postgresql://postgres:password@localhost:5432/nuee_dev
DATABASE_URL=postgresql://user:password@localhost:5432/nuee_dev

# Session secret used to sign the admin session cookie (required, generate a long random value)
SESSION_SECRET=replace-with-a-long-random-string

# Initial admin account, created by `npm run db:seed` if it does not already exist
ADMIN_EMAIL=admin@nuee.example
ADMIN_PASSWORD=replace-with-a-strong-password

# Port the server listens on (optional, defaults to 5000)
PORT=5000

# Optional: enables "Upload Image" buttons in the admin dashboard (event covers,
# homepage gallery, etc.) via Cloudinary's free tier. Without these three set,
# the app still works fully — you can still paste image URLs by hand, you just
# won't see an upload button. Get these from your Cloudinary dashboard
# (Settings -> API Keys) after a free signup at cloudinary.com.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set automatically by npm scripts, do not set manually
NODE_ENV=development
